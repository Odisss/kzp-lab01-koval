# Результати Maven-збірки не є вихідним кодом.
target/

# Локальні налаштування середовищ розробки.
.idea/
*.iml
.vscode/

# Скомпільовані Java-класи та службові файли ОС.
*.class
.DS_Store
Thumbs.db

# Згенерований звіт програми (каталог out/ створюється програмою).
out/

# Звіти у форматі Word здаються окремо у ВНС і не є частиною проєкту.
*.docx

# Python (ЛР № 6): віртуальні середовища, збірка, кеші та згенеровані звіти.
.venv/
.venv-wheel/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
reports/
